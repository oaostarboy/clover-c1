-Export-ScheduledTask -TaskName 'Clover_OwnerWorker_Proof'
+if (Get-ScheduledTask -TaskName 'Clover_Gateway' -ErrorAction SilentlyContinue) { throw 'Refuse pre-existing public task' }
+Set-Location -LiteralPath $Source
+# The hosted admin account exercises the public supported Task install path.
+# No hand-built task action, principal, launcher or exported replacement XML.
+$env:CLOVER_HOME = Split-Path -Parent $Source
+$env:VIRTUAL_ENV = Split-Path -Parent (Split-Path -Parent $Python)
+& $Python -m clover_cli.main gateway install --no-start-now --start-on-login *> (Join-Path $Evidence 'task-registration-cli.log')
+if ($LASTEXITCODE -ne 0) { throw 'Public task registration failed' }
+$task = Get-ScheduledTask -TaskName 'Clover_Gateway' -ErrorAction Stop
+Export-ScheduledTask -TaskName $task.TaskName | Set-Content (Join-Path $Evidence 'public-task.xml') -Encoding utf8
+Start-ScheduledTask -InputObject $task
